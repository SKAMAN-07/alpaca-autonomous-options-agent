# ==============================================================================
# Alpaca Options Alpha Agent — Environment Configuration Template
# Duplicate this file to '.env' and populate with your credentials.
# ==============================================================================

# Alpaca Paper Trading Credentials
# Generate your keys at: https://app.alpaca.markets/paper/dashboard/overview
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets
APCA_API_DATA_URL=https://data.alpaca.markets

# Alpaca MCP Server V2 Compatibility
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Featherless AI Credentials (Serverless Open-Source LLM Inference)
# Generate your API key at: https://featherless.ai
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
